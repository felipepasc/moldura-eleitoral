PORT=6600
DATABASE_URL=postgres://moldura:moldura@localhost:5440/moldura
WEB_ORIGIN=http://localhost:6610
TRUST_PROXY=0
# Vendas: "true" (padrão) ou "false" (POST /orders devolve 503). Em produção comece com false.
SALES_ENABLED=true
LOG_LEVEL=info
MINIO_ENDPOINT=localhost
MINIO_PORT=9300
MINIO_USE_SSL=false
# Região S3: "us-east-1" (padrão, MinIO local); no Cloudflare R2 use "auto".
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=moldura
MINIO_SECRET_KEY=moldura-secret
MINIO_BUCKET=moldura
ABACATEPAY_API_KEY=
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2
ABACATEPAY_WEBHOOK_SECRET=

# Produção com Cloudflare R2 (mesma API S3; sem segredos aqui):
# MINIO_ENDPOINT=<account_id>.r2.cloudflarestorage.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_REGION=auto
# MINIO_BUCKET=<nome do bucket R2>
# MINIO_ACCESS_KEY=<Access Key ID do token S3 do R2>
# MINIO_SECRET_KEY=<Secret Access Key do token S3 do R2>
