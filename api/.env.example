PORT=6600
DATABASE_URL=postgres://moldura:moldura@localhost:5440/moldura
# Origem(ns) permitida(s) no CORS; lista separada por vírgula (ex.: https://molduraeleitoral.com,https://www.molduraeleitoral.com).
WEB_ORIGIN=http://localhost:6610
TRUST_PROXY=0
# Vendas: sem valor = fechadas ("false", POST /orders devolve 503). Em dev use "true"; em produção abra só quando for lançar.
SALES_ENABLED=true
# Blackout automático: intervalos início/fim (ISO-8601 com fuso), separados por vírgula. Sem a variável vale o padrão
# (dia da eleição do 2º turno); vazio = sem blackout; valor inválido impede a api de subir.
# SALES_BLACKOUT=2026-10-25T00:00:00-03:00/2026-10-26T17:00:00-03:00
LOG_LEVEL=info
MINIO_ENDPOINT=localhost
MINIO_PORT=9300
MINIO_USE_SSL=false
# Região S3: "us-east-1" (padrão, MinIO local); no Cloudflare R2 use "auto".
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=moldura
MINIO_SECRET_KEY=moldura-secret
MINIO_BUCKET=moldura
# Pix pelo Core (https://felipepasc.com): a cobrança e o Pix saem do provedor configurado no CNPJ do serviço.
# CORE_API_KEY: chave fk_ do serviço (Core > Serviços > Integração; só aparece ao criar).
# CORE_WEBHOOK_SECRET: segredo whsec_ do endereço de aviso (pnpm --filter @moldura/api core:webhook <url da api>).
CORE_API_URL=https://felipepasc.com
CORE_API_KEY=fk_...
CORE_WEBHOOK_SECRET=whsec_...

# Produção com Cloudflare R2 (mesma API S3; sem segredos aqui):
# MINIO_ENDPOINT=<account_id>.r2.cloudflarestorage.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_REGION=auto
# MINIO_BUCKET=<nome do bucket R2>
# MINIO_ACCESS_KEY=<Access Key ID do token S3 do R2>
# MINIO_SECRET_KEY=<Secret Access Key do token S3 do R2>
